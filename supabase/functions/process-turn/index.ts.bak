      travel_description = `Р’С‹ СЂР°СЃРїР°С…РёРІР°РµС‚Рµ РґРІРµСЂСЊ Рё РІС‹С…РѕРґРёС‚Рµ РёР· ${currentLocationName || "РїРѕРјРµС‰РµРЅРёСЏ"} РЅР°СЂСѓР¶Сѓ РЅР° СЃРІРµР¶РёР№ РІРѕР·РґСѓС… РїСЂРёРґРѕСЂРѕР¶РЅРѕРіРѕ С‚СЂР°РєС‚Р°.`;
      time_passed_minutes = Math.max(time_passed_minutes, 5);
