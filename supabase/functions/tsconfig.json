{
  "compilerOptions": {
    "target": "esnext",
    "module": "esnext",
    "moduleResolution": "bundler",
    "noImplicitAny": false,
    "allowJs": true,
    "strict": false,
    "lib": ["esnext", "dom"],
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "noEmit": true
  },
  "include": ["**/*"]
}
