    const isBuildingLocation = /Р РЋРІР‚С™Р В Р’В°Р В Р вЂ Р В Р’ВµР РЋР вЂљР В Р вЂ¦|Р РЋРІР‚С™Р РЋР вЂљР В Р’В°Р В РЎвЂќР РЋРІР‚С™Р В РЎвЂР РЋР вЂљ|Р В РЎвЂ”Р В РЎвЂўР РЋР С“Р РЋРІР‚С™Р В РЎвЂўР РЋР РЏР В Р’В»|Р В РўвЂР В РЎвЂўР В РЎВ|Р В РЎвЂ”Р В РЎвЂўР В РўвЂР В Р вЂ Р В Р’В°Р В Р’В»|Р В РЎвЂ“Р РЋР вЂљР В РЎвЂўР РЋРІР‚С™|Р В РЎвЂќР В Р’В°Р РЋРІР‚С™Р В Р’В°Р В РЎвЂќР В РЎвЂўР В РЎВР В Р’В±|Р В РЎвЂ”Р В РЎвЂўР В РЎвЂ“Р РЋР вЂљР В Р’ВµР В Р’В±|tavern|building|dungeon/i.test(currentLocationType || "") ||
