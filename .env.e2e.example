# .env.e2e.example — Переменные окружения для E2E тестов
# Скопируй в .env.e2e и заполни своими значениями
# Файл .env.e2e добавлен в .gitignore — ключи не попадут в репозиторий

# Supabase
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
E2E_SUPABASE_SERVICE_KEY=your-service-role-key

# OpenRouter
VITE_OPENROUTER_API_KEY=sk-or-v1-...
# или
E2E_OPENROUTER_KEY=sk-or-v1-...

# Адрес сайта для тестов (по умолчанию — GitHub Pages)
# E2E_BASE_URL=https://ainz-oul-gown.github.io/Multi-RP
# E2E_BASE_URL=http://localhost:5173

# Тестовый аккаунт (по умолчанию встроен)
# E2E_TEST_EMAIL=e2e_playwright_test@multirp.test
# E2E_TEST_PASSWORD=E2ePlaywright2026!
